{
  "name": "@absolutejs/devices-capacitor",
  "version": "0.6.1",
  "description": "Capacitor runtime adapter for @absolutejs/devices",
  "type": "module",
  "license": "BSL-1.1",
  "author": "Alex Kahn",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/absolutejs/devices.git",
    "directory": "packages/devices-capacitor"
  },
  "homepage": "https://github.com/absolutejs/devices",
  "bugs": {
    "url": "https://github.com/absolutejs/devices/issues"
  },
  "files": [
    "android/src/main/",
    "android/build.gradle",
    "dist",
    "ios/Sources/",
    "Package.swift",
    "AbsoluteDevicesCapacitor.podspec",
    "README.md"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "capacitor": {
    "android": {
      "src": "android"
    },
    "ios": {
      "src": "ios"
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./clipboard": {
      "types": "./dist/clipboard.d.ts",
      "import": "./dist/clipboard.js"
    },
    "./camera": {
      "types": "./dist/camera.d.ts",
      "import": "./dist/camera.js"
    },
    "./haptics": {
      "types": "./dist/haptics.d.ts",
      "import": "./dist/haptics.js"
    },
    "./location": {
      "types": "./dist/location.d.ts",
      "import": "./dist/location.js"
    },
    "./local-notifications": {
      "types": "./dist/localNotifications.d.ts",
      "import": "./dist/localNotifications.js"
    },
    "./documents": {
      "types": "./dist/documents.d.ts",
      "import": "./dist/documents.js"
    },
    "./share": {
      "types": "./dist/share.d.ts",
      "import": "./dist/share.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun build src/index.ts src/camera.ts src/clipboard.ts src/documents.ts src/haptics.ts src/localNotifications.ts src/location.ts src/share.ts --outdir dist --target=browser --external @absolutejs/devices --external @capacitor/core --external @capacitor/app --external @capacitor/browser --external @capacitor/camera --external @capacitor/clipboard --external @capacitor/file-viewer --external @capacitor/filesystem --external @capacitor/geolocation --external @capacitor/haptics --external @capacitor/local-notifications --external @capacitor/network --external @capacitor/preferences --external @capacitor/share && tsc --emitDeclarationOnly -p tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@capacitor/app": "^8.0.0",
    "@capacitor/browser": "^8.0.0",
    "@capacitor/network": "^8.0.0",
    "@capacitor/preferences": "^8.0.0"
  },
  "peerDependencies": {
    "@absolutejs/devices": "^0.5.0",
    "@capacitor/camera": ">=8.1 <9",
    "@capacitor/clipboard": ">=8 <9",
    "@capacitor/core": ">=8 <9",
    "@capacitor/file-viewer": ">=2 <3",
    "@capacitor/filesystem": ">=8.1 <9",
    "@capacitor/geolocation": ">=8.2 <9",
    "@capacitor/haptics": ">=8 <9",
    "@capacitor/local-notifications": ">=8.2 <8.3",
    "@capacitor/share": ">=8 <9"
  },
  "peerDependenciesMeta": {
    "@capacitor/camera": {
      "optional": true
    },
    "@capacitor/clipboard": {
      "optional": true
    },
    "@capacitor/file-viewer": {
      "optional": true
    },
    "@capacitor/filesystem": {
      "optional": true
    },
    "@capacitor/geolocation": {
      "optional": true
    },
    "@capacitor/haptics": {
      "optional": true
    },
    "@capacitor/local-notifications": {
      "optional": true
    },
    "@capacitor/share": {
      "optional": true
    }
  },
  "devDependencies": {
    "@absolutejs/devices": "workspace:*",
    "@capacitor/camera": "8.2.3",
    "@capacitor/clipboard": "8.0.1",
    "@capacitor/file-viewer": "2.0.2",
    "@capacitor/filesystem": "8.1.3",
    "@capacitor/geolocation": "8.2.2",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/local-notifications": "8.2.1",
    "@capacitor/share": "8.0.1"
  },
  "absolutejs": {
    "devices": {
      "capabilities": {
        "camera": {
          "factory": "createCapacitorCameraCapability",
          "module": "@absolutejs/devices-capacitor/camera",
          "packages": [
            "@capacitor/camera@8.2.3"
          ],
          "native": {
            "ios": {
              "usageDescriptions": [
                "camera",
                "photo-library",
                "photo-library-add"
              ]
            }
          }
        },
        "clipboard": {
          "factory": "createCapacitorClipboardCapability",
          "module": "@absolutejs/devices-capacitor/clipboard",
          "packages": [
            "@capacitor/clipboard@8.0.1"
          ]
        },
        "documents": {
          "factory": "createCapacitorDocumentsCapability",
          "module": "@absolutejs/devices-capacitor/documents",
          "packages": [
            "@capacitor/file-viewer@2.0.2",
            "@capacitor/filesystem@8.1.3",
            "@capacitor/share@8.0.1"
          ],
          "native": {
            "ios": {
              "privacyAccessedApis": {
                "NSPrivacyAccessedAPICategoryFileTimestamp": [
                  "C617.1"
                ]
              }
            }
          }
        },
        "haptics": {
          "factory": "createCapacitorHapticsCapability",
          "module": "@absolutejs/devices-capacitor/haptics",
          "packages": [
            "@capacitor/haptics@8.0.2"
          ]
        },
        "location": {
          "factory": "createCapacitorLocationCapability",
          "module": "@absolutejs/devices-capacitor/location",
          "packages": [
            "@capacitor/geolocation@8.2.2"
          ],
          "native": {
            "android": {
              "permissions": [
                "android.permission.ACCESS_COARSE_LOCATION",
                "android.permission.ACCESS_FINE_LOCATION"
              ]
            },
            "ios": {
              "usageDescriptions": [
                "location-always",
                "location-when-in-use"
              ]
            }
          }
        },
        "localNotifications": {
          "factory": "createCapacitorLocalNotificationsCapability",
          "module": "@absolutejs/devices-capacitor/local-notifications",
          "packages": [
            "@capacitor/local-notifications@8.2.1"
          ],
          "native": {
            "android": {
              "permissions": [
                "android.permission.POST_NOTIFICATIONS"
              ]
            }
          }
        },
        "photos": {
          "factory": "createCapacitorPhotosCapability",
          "module": "@absolutejs/devices-capacitor/camera",
          "packages": [
            "@capacitor/camera@8.2.3"
          ],
          "native": {
            "ios": {
              "usageDescriptions": [
                "camera",
                "photo-library",
                "photo-library-add"
              ]
            }
          }
        },
        "share": {
          "factory": "createCapacitorShareCapability",
          "module": "@absolutejs/devices-capacitor/share",
          "packages": [
            "@capacitor/share@8.0.1"
          ]
        }
      },
      "format": 1,
      "provider": "capacitor"
    }
  }
}
