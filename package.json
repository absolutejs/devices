{
  "name": "absolutejs-devices-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "bun run --cwd packages/devices build && bun run --cwd packages/devices-capacitor build",
    "check": "bun run typecheck && bun test && bun run build",
    "format": "prettier --write .",
    "test": "bun test",
    "typecheck": "bun run --filter '@absolutejs/devices*' typecheck"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "prettier": "latest",
    "typescript": "5.9.3"
  }
}
